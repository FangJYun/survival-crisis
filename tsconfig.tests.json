{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-output",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "assets/scripts/domain/**/*.ts",
    "assets/scripts/application/**/*.ts",
    "assets/scripts/platform/**/*.ts"
  ],
  "exclude": [
    "assets/scripts/platform/content.ts"
  ]
}
